# Strata site origin the app browses and accepts universal links from (src/strata-origin.json holds the default).
EXPO_PUBLIC_STRATA_ORIGIN=https://strata.example

# Set to 1 in .env.local only, to allow a loopback HTTP origin during development.
EXPO_PUBLIC_STRATA_DEV=

# Optional dev-only capability URL to open on launch instead of /home. It is a bearer URL,
# so set it in .env.local only.
EXPO_PUBLIC_STRATA_DEV_PRESENTATION_URL=

# Release identifiers from the Apple and Google developer accounts. Setting either one
# makes EXPO_PUBLIC_STRATA_ORIGIN mandatory, since it is built into the binary.
STRATA_IOS_BUNDLE_IDENTIFIER=
STRATA_ANDROID_PACKAGE=

# iOS build number and Android version code; must increase on every store upload.
STRATA_BUILD_NUMBER=
