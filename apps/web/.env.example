# Strata environment. Copy to .env.local and fill in; never commit values.

# --- database (Neon) -------------------------------------------------------
# Pooled Neon connection string, used at request time.
DATABASE_URL=
# Direct (non-pooled) Neon connection string, used for migrations only.
DATABASE_URL_UNPOOLED=

# --- server-side capability material --------------------------------------
# 32-byte hex key that encrypts stored share keys and signs asset URLs.
# STRATA_URL_KEY_OLD holds the prior key only while a rotation rewraps values.
STRATA_URL_KEY=
STRATA_URL_KEY_OLD=

# --- abuse-control source pseudonyms --------------------------------------
# Server-only HMAC key for rate-limit pseudonyms: 32 random bytes as 64 hex or 43 base64url chars.
# Never expose it as NEXT_PUBLIC_ or EXPO_PUBLIC_; rotating it resets quota windows.
STRATA_SOURCE_HASH_KEY=

# --- identity (WorkOS Magic Auth) ------------------------------------------
# WorkOS API key and client ID (WorkOS dashboard), required for email sign-in codes.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# --- minted URLs -----------------------------------------------------------
# Bare origin for share links and canonical addresses. Required in production, where
# X-Forwarded-Host is not trusted.
PUBLIC_BASE_URL=

# --- mobile link association ----------------------------------------------
# Comma-separated Apple app IDs (TEAM_ID.bundle.id). Leave unset until the signed app exists.
STRATA_IOS_APP_IDS=
# Android application id and comma-separated SHA-256 signing fingerprints.
STRATA_ANDROID_PACKAGE=
STRATA_ANDROID_SHA256_CERT_FINGERPRINTS=

# Bearer secret Vercel sends to /api/cron/sweep; set it in the Vercel project env.
CRON_SECRET=
