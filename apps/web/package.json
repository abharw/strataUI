{
  "name": "@strata/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "test": "dotenv -e .env.test.local -- vitest run",
    "test:unit": "vitest run --exclude \"**/*.db.test.{ts,tsx}\"",
    "check:bundle-budget": "tsx scripts/check-route-bundles.ts",
    "eval:composition": "tsx scripts/composition-eval.ts",
    "gen:manifest": "tsx scripts/gen-manifest.ts",
    "e2e:agent-loop": "node scripts/agent-loop.mjs",
    "dev:mint-credential": "dotenv -e .env.local -- tsx scripts/mint-credential.ts",
    "keys:rewrap-sealed": "dotenv -e .env.local -- tsx scripts/rewrap-sealed-keys.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@json-render/core": "0.20.0",
    "@json-render/directives": "0.20.0",
    "@json-render/react": "0.20.0",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/functions": "^3.9.5",
    "@workos-inc/node": "^10.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "image-size": "^1.2.1",
    "input-otp": "^1.5.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@json-render/devtools-react": "0.20.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
